      "text": "I was worried they wouldn't bloom in time."
    },
    "arrival_02": {
      "speaker": "oliver",
      "text": "I suppose they just needed a little trip."
    },
    "arrival_03": {
      "speaker": "oliver",
      "text": "For your window."
    },
    "arrival_04": {
