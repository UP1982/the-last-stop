  "completion": {
    "action": "board_oliver",
    "destination": "train_travel"
  },
  "id": "intro",
  "kind": "dialogue",
  "lines": {
    "intro_01": {
      "speaker": "oliver",
      "text": "Does this one go to Clover Market?"
    },
    "intro_02": {
      "speaker": "oliver",
      "text": "Oh, good. My flowers are beginning to think I made it up."
    },
    "intro_call_01": {
      "delivery": "offscreen",
      "speaker": "oliver",
      "text": "Excuse me!"
    },
    "prologue_rin_01": {
      "speaker": "rin",
      "text": "First day on this line?"
    },
    "prologue_rin_02": {
      "speaker": "rin",
      "text": "Brass knows the way. You look after the passengers."
    },
    "prologue_rin_03": {
      "speaker": "rin",
      "text": "The Last Stop. We used to have supper there when the lamps came on."
    },
    "prologue_rin_04": {
      "speaker": "rin",
      "text": "I thought I'd mend a few things. See who turns up."
    },
    "prologue_rin_05": {
      "speaker": "rin",
      "text": "That's a start."
    }
  },
  "order": [
    "prologue_rin_01",
    "prologue_rin_02",
